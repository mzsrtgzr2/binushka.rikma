# Copy to .env for local `vercel dev` only — never commit .env
# Set the same names in Vercel → Project → Settings → Environment Variables

# sandbox | production
MORNING_ENV=sandbox

# From Morning: המשתמש שלי → כלי מפתחים → API Keys
MORNING_API_KEY_ID=
MORNING_API_KEY_SECRET=

# Payment plugin UUID. Discover via GET /documents/info?type=320 → paymentPlugins[0].id
MORNING_PLUGIN_ID=

# Optional
MORNING_CHECKOUT_TITLE=תשלום בחנות בינושקה
MORNING_DOCUMENT_TYPE=320
MORNING_VAT_TYPE=1
MORNING_PAYMENT_GROUP=100
MORNING_MAX_PAYMENTS=12
MORNING_GUEST_NAME=לקוחה מהאתר
MORNING_GUEST_EMAIL=
MORNING_NOTIFY_URL=
# Local only. If true and PLUGIN_ID is empty, checkout redirects to /thanks/ without charging.
MORNING_DEV_SKIP_PAYMENT=
