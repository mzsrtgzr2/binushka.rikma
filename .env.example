# Copy to .env for local `vercel dev` only — never commit .env
# Same names go in Vercel → Project → Settings → Environment Variables

# sandbox | production  — keep sandbox until live charging is intended
MORNING_ENV=sandbox

# Morning / Green Invoice: המשתמש שלי → כלי מפתחים → API Keys
# Use the sandbox key pair while MORNING_ENV=sandbox
MORNING_API_KEY_ID=
MORNING_API_KEY_SECRET=

# Production Grow plugin. Ignored in sandbox (it 404s there).
MORNING_PLUGIN_ID=453df580-760d-439d-a848-4fe7dc1fb9b3

# Sandbox Grow / Morning clearing plugin
MORNING_SANDBOX_PLUGIN_ID=facd67fd-5082-496c-917f-830f0d7449e3

# Optional
SITE_URL=https://rikma.binushka.com
MORNING_CHECKOUT_TITLE=תשלום בחנות בינושקה
MORNING_DOCUMENT_TYPE=320
# Income row VAT: 1 = price includes VAT
MORNING_VAT_TYPE=1
# Document VAT: 0 = business default. Do not copy MORNING_VAT_TYPE here.
MORNING_DOCUMENT_VAT_TYPE=0
MORNING_PAYMENT_GROUP=100
# 1 = one payment. Only raise this if the customer should be offered installments.
MORNING_MAX_PAYMENTS=1
MORNING_NOTIFY_URL=

# Local / preview only. If true and PLUGIN_ID is empty, checkout redirects to /thanks/ without charging.
MORNING_DEV_SKIP_PAYMENT=

# Store backoffice at /admin/
ADMIN_PASSWORD=
GITHUB_TOKEN=
GITHUB_BRANCH=master
# Local writes to this repo root. Leave empty on Vercel (GitHub token is used there).
ADMIN_LOCAL_ROOT=
