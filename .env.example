# Copy to .env for local `vercel dev` only — never commit .env
# Same names go in Vercel → Project → Settings → Environment Variables

# sandbox | production  — keep sandbox until live charging is intended
MORNING_ENV=sandbox

# Morning / Green Invoice: המשתמש שלי → כלי מפתחים → API Keys
# Use the sandbox key pair while MORNING_ENV=sandbox
MORNING_API_KEY_ID=
MORNING_API_KEY_SECRET=

# Production Grow plugin. Ignored in sandbox (it 404s there).
MORNING_PLUGIN_ID=453df580-760d-439d-a848-4fe7dc1fb9b3

# Sandbox Grow / Morning clearing plugin
MORNING_SANDBOX_PLUGIN_ID=facd67fd-5082-496c-917f-830f0d7449e3

# Optional
SITE_URL=https://rikma.binushka.com
MORNING_CHECKOUT_TITLE=תשלום בחנות בינושקה
MORNING_DOCUMENT_TYPE=320
# Income row VAT: 1 = price includes VAT
MORNING_VAT_TYPE=1
# Document VAT: 0 = business default. Do not copy MORNING_VAT_TYPE here.
MORNING_DOCUMENT_VAT_TYPE=0
MORNING_PAYMENT_GROUP=100
# 1 = one payment. Only raise this if the customer should be offered installments.
MORNING_MAX_PAYMENTS=1
MORNING_NOTIFY_URL=

# Local / preview only. If true and PLUGIN_ID is empty, checkout redirects to /thanks/ without charging.
MORNING_DEV_SKIP_PAYMENT=

# Backoffice at /admin/store/ and /admin/newsletter/, one password for both.
# One password covers both.
ADMIN_PASSWORD=
GITHUB_TOKEN=
# A preview ignores this and writes to the branch it was deployed from, so
# trying the backoffice out there cannot commit to the live site.
GITHUB_BRANCH=master
# Local writes to this repo root. Leave empty on Vercel (GitHub token is used there).
ADMIN_LOCAL_ROOT=

# Newsletter — see NEWSLETTER_SETUP.md

# Subscriber list. Create a Blob store in the Vercel dashboard and it sets this
# for you. Without it the signup form reports that it is unavailable.
BLOB_READ_WRITE_TOKEN=

# Signs the unsubscribe links that go out in every issue. Generate once with
# `openssl rand -hex 32` and never rotate it casually: changing it invalidates
# the unsubscribe link in every mail already sitting in someone's inbox.
NEWSLETTER_SECRET=

# Delivery. GMAIL_APP_PASSWORD is a 16-character app password, not the account
# password — Google stopped accepting those. Requires 2-Step Verification.
# Gmail rewrites the From: header to GMAIL_USER whatever we put there.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Recipients per send. Personal Gmail allows 500/day and Workspace 2000; the
# default of 400 leaves room so a send cannot trip Google's abuse limits.
NEWSLETTER_DAILY_CAP=400

# A preview normally shares the production blob store, so its subscriber list is
# the real one and a full send there would mail real people. Test sends to a
# single address always work; set this to 1 only to deliberately allow a full
# send from a preview.
# NEWSLETTER_ALLOW_PREVIEW_SEND=1

# Canonical site URL. Links inside a mail must point at the real site even when
# the send was triggered from a preview deployment.
SITE_URL=https://rikma.binushka.com
