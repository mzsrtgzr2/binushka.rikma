{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "jekyll",
  "installCommand": "bundle install",
  "buildCommand": "node scripts/build-catalog.js && JEKYLL_ENV=production bundle exec jekyll build",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "{_store,_projects}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*/", "destination": "/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.ico|hero4.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
